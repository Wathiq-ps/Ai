%%---------------------------------------------------------------------------
%% Wathiq — Entity Relationship Diagram
%% Generated from 00_foundation.sql .. 11_grants.sql
%% Columns are trimmed to PK/FK + a few defining fields for readability.
%% Full column lists, constraints, enums and triggers live in the SQL files.
%%---------------------------------------------------------------------------
erDiagram

%% ===================== REFERENCE (01) =====================
TENANTS {
    uuid id PK
    varchar slug
    varchar name_en
    enum status
}
CURRENCIES {
    char code PK
    smallint exponent
}
COUNTRIES {
    uuid id PK
    char iso2
    char iso3
}
JURISDICTIONS {
    uuid id PK
    uuid country_id FK
    varchar code
}
LOCATIONS {
    uuid id PK
    uuid parent_id FK
    uuid country_id FK
    enum level
}

%% ===================== IDENTITY (02) =====================
USERS {
    uuid id PK
    citext email
    enum status
}
USER_PROFILES {
    uuid user_id PK
    varchar first_name
    varchar last_name
    uuid nationality_id FK
    uuid location_id FK
}
ROLES {
    uuid id PK
    varchar code
}
PERMISSIONS {
    uuid id PK
    varchar code
}
ROLE_PERMISSIONS {
    uuid role_id PK
    uuid permission_id PK
}
TENANT_MEMBERSHIPS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    uuid role_id FK
    enum status
}
LAWYER_CREDENTIALS {
    uuid user_id PK
    varchar license_number
    uuid jurisdiction_id FK
}
USER_SESSIONS {
    uuid id PK
    uuid user_id FK
    uuid replaced_by_id FK
}
ONE_TIME_TOKENS {
    uuid id PK
    uuid user_id FK
    enum purpose
}
IDENTITY_DOCUMENTS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    uuid issuing_country_id FK
    enum status
}

%% ===================== PROPERTY (03) =====================
PROPERTIES {
    uuid id PK
    uuid tenant_id FK
    uuid owner_id FK
    uuid broker_id FK
    uuid location_id FK
    enum status
}
PROPERTY_MEDIA {
    uuid id PK
    uuid property_id FK
    boolean is_cover
}
OWNERSHIP_DOCUMENTS {
    uuid id PK
    uuid property_id FK
    uuid uploaded_by FK
    enum status
}
AMENITIES {
    uuid id PK
    varchar code
}
PROPERTY_AMENITIES {
    uuid property_id PK
    uuid amenity_id PK
}
FAVORITES {
    uuid user_id PK
    uuid property_id PK
}

%% ===================== REQUESTS (04) =====================
PROPERTY_REQUESTS {
    uuid id PK
    uuid tenant_id FK
    uuid property_id FK
    uuid requester_id FK
    enum status
}

%% ===================== CONTRACTS (05) =====================
CONTRACTS {
    uuid id PK
    uuid tenant_id FK
    uuid request_id FK
    uuid property_id FK
    uuid owner_id FK
    uuid beneficiary_id FK
    uuid lawyer_id FK
    uuid template_id FK
    uuid jurisdiction_id FK
    uuid current_version_id FK
    enum status
}
CONTRACT_VERSIONS {
    uuid id PK
    uuid contract_id FK
    integer version_no
    char content_hash
    uuid author_id FK
    uuid ai_job_id FK
}
CONTRACT_CLAUSES {
    uuid id PK
    uuid contract_version_id FK
    enum kind
}
CONTRACT_TEMPLATES {
    uuid id PK
    uuid tenant_id FK
    uuid jurisdiction_id FK
}
CONTRACT_STATUS_HISTORY {
    uuid id PK
    uuid contract_id FK
    enum to_status
    uuid actor_id FK
}

%% ===================== AI & KNOWLEDGE (06) =====================
KB_VERSIONS {
    uuid id PK
    uuid jurisdiction_id FK
    varchar tag
    enum status
}
KNOWLEDGE_SOURCES {
    uuid id PK
    uuid jurisdiction_id FK
    boolean is_verified
}
KNOWLEDGE_DOCUMENTS {
    uuid id PK
    uuid source_id FK
}
KNOWLEDGE_CHUNKS {
    uuid id PK
    uuid kb_version_id FK
    uuid document_id FK
    uuid jurisdiction_id FK
    vector embedding
}
AI_JOBS {
    uuid id PK
    uuid tenant_id FK
    uuid contract_id FK
    uuid requested_by FK
    uuid kb_version_id FK
    enum status
}
CONTRACT_ANALYSES {
    uuid id PK
    uuid contract_id FK
    uuid contract_version_id FK
    uuid ai_job_id FK
    smallint risk_score
}
ANALYSIS_FINDINGS {
    uuid id PK
    uuid analysis_id FK
    uuid clause_id FK
    enum severity
    enum resolution
}

%% ===================== SIGNATURES (07) =====================
SIGNATURE_INVITATIONS {
    uuid id PK
    uuid contract_id FK
    uuid contract_version_id FK
    uuid signer_id FK
    enum status
}
SIGNATURES {
    uuid id PK
    uuid contract_id FK
    uuid contract_version_id FK
    uuid invitation_id FK
    uuid signer_id FK
    char document_hash
}
CONTRACT_SEALS {
    uuid id PK
    uuid contract_id FK
    uuid contract_version_id FK
    char pdf_sha256
}

%% ===================== PAYMENTS (08) =====================
PAYMENTS {
    uuid id PK
    uuid tenant_id FK
    uuid contract_id FK
    uuid payer_id FK
    char currency FK
    enum status
}
PAYMENT_EVENTS {
    uuid id PK
    uuid payment_id FK
    enum to_status
}
WALLETS {
    uuid id PK
    uuid user_id FK
    char currency FK
    bigint balance
}
WALLET_ENTRIES {
    uuid id PK
    uuid wallet_id FK
    enum direction
    bigint balance_after
}
RECEIPTS {
    uuid id PK
    uuid payment_id FK
    varchar number
}

%% ===================== EXECUTION (09) =====================
HANDOVER_CODES {
    uuid id PK
    uuid contract_id FK
    uuid issued_by FK
    uuid consumed_by FK
    enum status
}
CONTRACT_EXECUTIONS {
    uuid id PK
    uuid contract_id FK
    uuid actor_id FK
    enum step
}

%% ===================== PLATFORM (10) =====================
NOTIFICATION_TYPES {
    varchar code PK
    boolean is_mandatory
}
NOTIFICATIONS {
    uuid id PK
    uuid tenant_id FK
    uuid user_id FK
    varchar type_code FK
    enum status
}
NOTIFICATION_PREFERENCES {
    uuid user_id PK
    varchar type_code PK
    enum channel PK
}
OUTBOX {
    bigint id PK
    uuid tenant_id
    varchar aggregate_type
}
WEBHOOK_DELIVERIES {
    uuid id PK
    varchar direction
    varchar source
}
IDEMPOTENCY_KEYS {
    uuid id PK
    uuid tenant_id
    varchar endpoint
}
AUDIT_LOGS {
    bigint id PK
    uuid tenant_id
    uuid actor_id
    varchar action
}

