# AI service's own copy of the shared values — see ../.env.example and
# docs/PHASE0_DECISIONS.md §6.

AI_SERVICE_API_KEY=
AI_WEBHOOK_SECRET=
LARAVEL_CALLBACK_URL=http://localhost:8000/api/ai/callback

# Postgres — wathiq_ai restricted role, knowledge.* only. Blank = get_pool() raises.
DATABASE_URL=postgresql://wathiq_ai:@localhost:5432/wathiq

# Leave these blank to run on FakeLLMProvider/FakeEmbeddingProvider
# (deterministic, no network) — that's what tests use.

# OpenRouter — embeddings + reranker, both free-tier (nvidia/*:free). OpenRouter
# logs all prompts/output on free models and marks them "trial use only, not
# for production" — fine for Sprint 4/5 dev + golden-set eval, NOT fine once
# real client contracts flow through. Revisit before Sprint 7 goes live.
# nemotron-3-embed-1b only accepts its native 2048 `dimensions`; the provider
# asks for 2048 and truncates + renormalizes to EMBEDDING_DIMENSIONS locally.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=1536
EMBEDDING_NATIVE_DIMENSIONS=2048
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# DeepSeek — LLM, direct platform API (not OpenRouter — trades away the
# cheaper-+-failover reasoning the ratified decision was made on, your call).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-pro
